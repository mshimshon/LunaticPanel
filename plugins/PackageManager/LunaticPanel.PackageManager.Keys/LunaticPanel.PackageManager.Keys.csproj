<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>
	  <Title>$(AssemblyName)</Title>
	  <Version>$(GlobalVersion)</Version>
	  <Company>$(GlobalCompany)</Company>
	  <Copyright>$(GlobalCopyright)</Copyright>
	  <Authors>$(GlobalAuthors)</Authors>
	  <Description>Lunatic Panel Package Manager Keys for Plugin Comunication Bus.</Description>
	  <PackageProjectUrl>https://github.com/mshimshon/LunaticPanel</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/mshimshon/LunaticPanel</RepositoryUrl>
	  <Configurations>Debug;Release;</Configurations>
	  <PackageIcon>../../icon.png</PackageIcon>
	  <PackageReadmeFile>../keys.md</PackageReadmeFile>
  </PropertyGroup>

</Project>
