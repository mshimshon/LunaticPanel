@using LunaticPanel.PackageManager.Components.ViewModels
@inherits WidgetComponentBase<PluginEntry, IPanelUpdateInformationViewModel>
@if (ViewModel.HasUpdateAvailable)
{
    <MudItem xs=12>
        <MudGrid>
            <MudItem xs=12>
                @if (ViewModel.HasStaged)
                {
                    <MudAlert Severity=@Severity.Info>
                        @string.Format(FOUND_STAGE, ViewModel.Version)
                    </MudAlert>
                }
                else if (ViewModel.HasDownloaded)
                {
                    <MudAlert Severity=@Severity.Warning>
                        @string.Format(PANEL_DOWNLOADED, ViewModel.Version)
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity=@Severity.Normal>
                        @string.Format(FOUND_UPDATE, ViewModel.Version)
                    </MudAlert>
                }
            </MudItem>
        </MudGrid>
    </MudItem>
}

