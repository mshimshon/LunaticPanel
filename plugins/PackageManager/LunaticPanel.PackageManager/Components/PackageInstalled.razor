@using LunaticPanel.PackageManager.Components.ViewModels

@inherits WidgetComponentBase<PluginEntry, IPackageInstalledViewModel>
<MudGrid>
    @if (!ViewModel.PackageManagerState.IsInitialized)
    {
        <MudItem xs=12>
            <MudAlert Severity=Severity.Error>
                @NOT_INIT_ERROR
            </MudAlert>
        </MudItem>
    }
    else if (!ViewModel.PackageManagerState.IsInitialized)
    {
        <MudItem xs=12>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
            <MudText>@("Initializing")</MudText>
        </MudItem>
    }
    else if (ViewModel.PackageManagerState.IsLoading)
    {
        <MudItem xs=12>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
            <MudText>@("Loading")</MudText>
        </MudItem>
    }
    else
    {
        <MudItem xs="12">
            <MudButton OnClick=ViewModel.CheckForUpdates  Disabled=@ViewModel.IsLoading>Check Updates</MudButton>
        </MudItem>
        @foreach (var package in ViewModel.PackageManagerState.Installed)
        {
            <MudItem xs=12 >
                <PackageInstalledCard Data=@package />
            </MudItem>
        }
    }

</MudGrid>
