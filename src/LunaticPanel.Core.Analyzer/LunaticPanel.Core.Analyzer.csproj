<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>12.0</LangVersion>
		<IsPackable>true</IsPackable>
		<IsRoslynAnalyzer>true</IsRoslynAnalyzer>
		<PackageType>Analyzer</PackageType>
		<!-- Avoid ID conflicts with the package project. -->
		<PackageId>$(AssemblyName)</PackageId>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<Configurations>Debug;Release;PipelineStart;PipelineStop</Configurations>
		<!-- 2. Ensure symbols packaging doesn't break a library-less pack -->
		<IncludeSymbols>false</IncludeSymbols>
		<!-- FIX RS1036: Enforce modern analyzer rule validations -->
		<EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
		<PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
	</ItemGroup>
	<ItemGroup>
		<AdditionalFiles Include="@(RazorComponent)" />
		<AdditionalFiles Include="**\*.razor" />
	</ItemGroup>
	<ItemGroup>
		<!-- 3. Explicitly bundle the analyzer DLL into the correct NuGet path -->
		<None Include="$(OutputPath)\$(AssemblyName).dll"
			  Pack="true"
			  PackagePath="analyzers/dotnet/cs"
			  Visible="false" />
	</ItemGroup>
	
	<Target Name="CopyNuPkg" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release'">
		<MakeDir Directories="..\..\..\..\nupkgs" />
		<ItemGroup>
			<PackageFiles Include="$(PackageOutputPath)$(PackageId).$(PackageVersion).nupkg" />
		</ItemGroup>
		<Copy SourceFiles="@(PackageFiles)" DestinationFolder="..\..\..\..\nupkgs" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" Condition="'$(BuildingInsideVisualStudio)' == 'true'" />
	</Target>
</Project>
