@using LunaticPanel.PackageManager.Components.ViewModels
@inherits WidgetComponentBase<PluginEntry, IPackageInstalledCardViewModel>


<MudCard>
    <MudCardContent>
        <MudText>@ViewModel.Data.Info.Name</MudText>
        <MudText Typo="Typo.subtitle1">@ViewModel.Data.Info.PackageId</MudText>
        <MudText Typo="Typo.body2">@ViewModel.Data.Info.Description</MudText>
        <MudChip T="string" Color="Color.Primary">@($"v{ViewModel.Data.Version}")</MudChip>
        @if (ViewModel.Data.Info.State == Application.Payloads.Enums.PackageStatePayload.Enabled)
        {
            <MudChip T="string" Color="Color.Default">@(PACKAGE_ENABLED)</MudChip>
        }
        else if (ViewModel.Data.Info.State == Application.Payloads.Enums.PackageStatePayload.Disabled)
        {
            <MudChip T="string" Color="Color.Primary">@(PACKAGE_DISABLED)</MudChip>
        }
    </MudCardContent>
    <MudCardActions>
        @if (ViewModel.HasUpdateScheduled)
        {
            <MudAlert Severity=Severity.Info>
                @string.Format(PACKAGE_UPDATE_SCHEDULED, ViewModel.ScheduledUpdate!.Version)
            </MudAlert>
            <MudButton Variant="Variant.Text" Color="Color.Warning" Disabled>
                @PACKAGE_UPDATE_ROLLBACK_CONFLICT
            </MudButton>
        }
        
        @if (!ViewModel.HasUpdateScheduled && ViewModel.CanScheduleUpdate)
        {
            <MudButton Variant="Variant.Text" Color="Color.Warning">
                @string.Format(PACKAGE_UPDATE, ViewModel.AvailableUpdate!.Version)
            </MudButton>
        }
        else if (!ViewModel.HasUpdateScheduled && ViewModel.CanCancelScheduledUpdate)
        {
            <MudButton Variant="Variant.Text" Color="Color.Warning">
                @string.Format(PACKAGE_UPDATE_CANCEL, ViewModel.AvailableUpdate!.Version)
            </MudButton>
        }

        @if (!ViewModel.HasUpdateScheduled && ViewModel.CanScheduleRollback)
        {
            <MudButton Variant="Variant.Text" Color="Color.Warning">
                @string.Format(PACKAGE_ROLLBACK, ViewModel.AvailableRollback!.Version)
            </MudButton>
        }
        else if (!ViewModel.HasUpdateScheduled && ViewModel.CanCancelScheduledRollback)
        {
            <MudButton Variant="Variant.Text" Color="Color.Warning">
                @string.Format(PACKAGE_ROLLBACK_CANCEL, ViewModel.AvailableRollback!.Version)
            </MudButton>
        }
    </MudCardActions>
</MudCard>