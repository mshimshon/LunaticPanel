@using LunaticPanel.PackageManager.Components.ViewModels
@inherits WidgetComponentBase<PluginEntry, IPackageSearchViewModel>
<MudGrid>
    <MudForm>
        <MudTextField T="string" @bind-Value=ViewModel.Keywords  Label="Search" 
        Variant="Variant.Outlined" 
        Adornment="Adornment.End" 
        AdornmentIcon=@Icons.Material.Filled.Search  
        AdornmentColor="Color.Secondary" />
    </MudForm>
    @if (ViewModel.SearchPackageState.IsLoading)
    {
        <MudItem xs=12>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        </MudItem>
    }
    else if (ViewModel.SearchPackageState.Search == default)
    {
        <MudItem xs=12>
            <MudText>
                @("No Package Results");
            </MudText>
        </MudItem>
    }
    else
    {
        @foreach (var package in ViewModel.SearchResult)
        {
            <MudItem xs=12>
                <PackageSearchCard OnParentStateHasChanged=OnParentStateHasChanged Data=@package />
            </MudItem>
        }
    }

</MudGrid>