@using LunaticPanel.PackageManager.Components.ViewModels
@inherits WidgetComponentBase<PluginEntry, ISourceManagerViewModel>
<MudGrid>
    @if (ViewModel.IsLoading)
    {
        <MudItem xs=12>
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        </MudItem>
    }
    else
    {
        <MudItem xs=12>
            <MudText>
                @($"{ViewModel.SourceState.Sources.Count()} Sources.")
            </MudText>
            <MudButton OnClick=@ViewModel.LoadSources>
                Load
            </MudButton>

            <MudButton OnClick=@ViewModel.AddSource>
                Add
            </MudButton>
        </MudItem>
        @foreach (var source in ViewModel.SourceState.Sources)
        {
            <MudItem xs=12>
                <SourceManagerCard @key="source.GetHashCode()" OnParentStateHasChanged=OnParentStateHasChanged Item=source />
            </MudItem>
        }
    }
</MudGrid>