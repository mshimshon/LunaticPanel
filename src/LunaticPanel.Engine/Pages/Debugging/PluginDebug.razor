
@page "/debugging/plugins"
<MudGrid>
    <MudItem>
        <MudTable Items=@PluginRegistry.KnownPlugins Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info">
            <HeaderContent>
                <MudTh>Plugin</MudTh>
                <MudTh>Startup State</MudTh>
                <MudTh>State</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Plugin">
                    <MudStack>
                        <MudText>@context.Manifest.Title</MudText>
                        <MudText>@context.Manifest.Id</MudText>
                        <MudText>vervion: @context.Manifest.Version</MudText>
                        <MudText>sdk: @context.Manifest.PanelVersion</MudText>
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Startup State">@context.StartupState.ToString()</MudTd>
                <MudTd DataLabel="Failure">
                    <MudStack>
                        <MudText>@(context.Failure?? "NA")</MudText>
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
</MudGrid>