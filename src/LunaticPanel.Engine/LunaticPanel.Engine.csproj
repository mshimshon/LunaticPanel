<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
	<Title>LunaticPanel.Engine</Title>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageProjectUrl>https://github.com/mshimshon/LunaticPanel</PackageProjectUrl>
	<Product>LunaticPanel.Engine</Product>
	<Version>$(GlobalVersion)</Version>
  	<InformationalVersion>$(GlobalVersion)</InformationalVersion>
  	<FileVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch)</FileVersion>
  	<AssemblyVersion>$(VersionMajor).0.0</AssemblyVersion>
	<Company>$(GlobalCompany)</Company>
	<Copyright>$(GlobalCopyright)</Copyright>
	<Authors>$(GlobalAuthors)</Authors>

	  <Description>LunaticPanel is a modular Blazor dashboard framework for building unified, server-oriented control applications with centralized orchestration and predictable composition.</Description>
	<PackageTags>blazor, dashboard, orchestration, server-management, modular, mudblazor, dotnet, control-plane, ui-framework</PackageTags>
	<Configurations>Debug;Release</Configurations>

  </PropertyGroup>

<ItemGroup>
	<PackageReference Include="CommandLineParser" />
	<PackageReference Include="DotNetCore.CAP" />
	<PackageReference Include="DotNetCore.CAP.Dashboard" />
	<PackageReference Include="DotNetCore.CAP.InMemoryStorage" />
	<PackageReference Include="McMaster.NETCore.Plugins" />
	<PackageReference Include="MudBlazor" />
	<PackageReference Include="StatePulse.Net" />
	<PackageReference Include="MaksimShimshon.Mediator" />
	<PackageReference Include="Microsoft.AspNetCore.Components.Web" />
</ItemGroup>

<ItemGroup>
  <ProjectReference Include="..\LunaticPanel.Core.Abstraction\LunaticPanel.Core.Abstraction.csproj" />
  <ProjectReference Include="..\LunaticPanel.Core.Extensions\LunaticPanel.Core.Extensions.csproj" />
  <ProjectReference Include="..\LunaticPanel.Core.PluginValidator\LunaticPanel.Core.PluginValidator.csproj" />
  <ProjectReference Include="..\LunaticPanel.Core.Utils\LunaticPanel.Core.Utils.csproj" />
  <ProjectReference Include="..\LunaticPanel.Core\LunaticPanel.Core.csproj" />
  <ProjectReference Include="..\LunaticPanel.Engine.Keys\LunaticPanel.Engine.Keys.csproj" />
  <ProjectReference Include="..\LunaticPanel.Engine.Plugin\LunaticPanel.Engine.Plugin.csproj" />
</ItemGroup>


  <ItemGroup>
	<InternalsVisibleTo Include="LunaticPanel.Engine.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
