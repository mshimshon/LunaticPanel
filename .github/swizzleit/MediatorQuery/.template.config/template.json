{
    "$schema": "http://schemastore.org",
    "author": "Internal",
    "classifications": [
        "C#",
        "Mediator"
    ],
    "identity": "Internal.MediatorQuery",
    "name": "Mediator Query",
    "shortName": "MediatorQueryOnly",
    "tags": {
        "language": "C#",
        "type": "item"
    },
    "sourceName": "_SourceName_",
