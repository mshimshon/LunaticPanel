{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach Panel (Running)",
            "type": "coreclr",
            "request": "attach",
            "processName": "LunaticPanel.Hybrid.Web",
            "justMyCode": false,
            "sourceFileMap": {
                "/srv/lunaticpanel": "${workspaceRoot}"
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceRoot}",
                "pipeProgram": "wsl.exe",
                "pipeArgs": [
                    "-d",
                    "lpcli_deploy",
                    "-u",
                    "root"
                ],
                "quoteArgs": false,
                "debuggerPath": "~/vsdbg/vsdbg"
            }
        },
        {
            "name": "Debug Panel (Complete)",
            "type": "coreclr",
            "preLaunchTask": "Run Panel DebugTool Rebuild",
            "postDebugTask": "Shutdown WSL",
            "request": "attach",
            "processId": "${command:pickRemoteProcess}",
            "justMyCode": false,
            "sourceFileMap": {
                "/srv/lunaticpanel": "${workspaceRoot}"
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceRoot}",
                "pipeProgram": "wsl.exe",
                "pipeArgs": [
                    "-d",
                    "lpcli_deploy",
                    "-u",
                    "root"
                ],
                "quoteArgs": false,
                "debuggerPath": "~/vsdbg/vsdbg"
            }
        },
        {
            "name": "Debug Panel (Fast)",
            "type": "coreclr",
            "preLaunchTask": "Run Panel DebugTool Skip Services",
            "postDebugTask": "Shutdown WSL",
            "request": "attach",
            "processName": "LunaticPanel.Hybrid.Web",
            "justMyCode": false,
            "sourceFileMap": {
                "/srv/lunaticpanel": "${workspaceRoot}"
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceRoot}",
                "pipeProgram": "wsl.exe",
                "pipeArgs": [
                    "-d",
                    "lpcli_deploy",
                    "-u",
                    "root"
                ],
                "quoteArgs": false,
                "debuggerPath": "~/vsdbg/vsdbg"
            }
        },
    ]
}
