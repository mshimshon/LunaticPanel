{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach Panel (Running)",
            "type": "coreclr",
            "request": "attach",
            "processName": "LunaticPanel.Hybrid.Web",
            "requireExactSource": false,
            "sourceLinkOptions": {
                "*": {
                    "enabled": false
                }
            },
            "logging": {
                "moduleLoad": true,
                "diagnosticsLog": {
                    "debugEngineAPITracing": "all",
                    "protocolMessages": true
                }
            },
            "pipeTransport": {
                "pipeCwd": "${workspaceRoot}",
                "pipeProgram": "wsl.exe",
                "pipeArgs": [
                    "-d",
                    "lpcli_deploy",
                    "-u",
                    "root"
                ],
                "quoteArgs": false,
                "debuggerPath": "/opt/vsdbg/vsdbg"
            }
        },
        {
            "name": "Debug Panel (Complete)",
