{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Install VSCODE Debugger",
            "type": "process",
            "command": "wsl",
            "args": [
                "-d",
                "lpcli_deploy",
                "-u",
                "root",
                "--",
                "bash",
                "-c",
                "apt install curl -y && mkdir -p /opt/vsdbg &&curl -sSL https://aka.ms/getvsdbgsh | /bin/bash /dev/stdin -v latest -l /opt/vsdbg"
            ],
            "problemMatcher": [],
            "presentation": {
                "close": true // <-- This automatically closes the terminal window on successful completion
            }
        },
        {
            "label": "Shutdown WSL",
            "type": "process",
            "command": "wsl",
            "args": [
                "--terminate",
                "lpcli_deploy",
            ],
            "problemMatcher": [],
            "presentation": {
                "close": true // <-- This automatically closes the terminal window on successful completion
            }
        },
        {
            "label": "Open Panel Logging",
            "type": "shell",
            "command": "wsl",
            "args": [
                "-d",
                "lpcli_deploy",
                "-u",
                "root",
                "--",
                "bash",
                "-c",
                "journalctl -u lunaticpanel -n 100 -f"
            ],
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^__never_matches__$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^__never_matches__$",
                    "endsPattern": "."
                }
            },
            "presentation": {
                "reveal": "always", // Focus and open the terminal panel automatically
                "panel": "dedicated", // Use the same terminal tab every time you run it
                "clear": true, // Clear the terminal screen before running
                "showReuseMessage": false,
                "group": "Lunatic Panel Server"
            },
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 1
            }
        },
        {
            "label": "Open LunaPackage Server Logging",
            "type": "shell",
            "command": "wsl",
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^__never_matches__$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^__never_matches__$",
                    "endsPattern": "."
                }
            },
            "runOptions": {
                "instanceLimit": 1
            },
            "args": [
                "-d",
                "lpcli_deploy",
                "-u",
                "root",
                "--",
                "bash",
                "-c",
                "journalctl -u lpkg_localserver -n 100 -f"
            ],
            "presentation": {
                "reveal": "always", // Focus and open the terminal panel automatically
                "panel": "dedicated", // Use the same terminal tab every time you run it
                "clear": true, // Clear the terminal screen before running
                "showReuseMessage": false,
                "group": "LunaPackage Server"
            },
        },
        {
            "label": "Publish DebugTool",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/tools/LunaticPanel.DebugTool/LunaticPanel.DebugTool.csproj",
                "-c",
                "Debug",
                "--self-contained",
                "true",
                "--runtime",
                "win-x64",
                "/p:DebugType=portable",
                "/p:CopyOutputSymbolsToPublishDirectory=true"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Publish Debug Panel",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/src/LunaticPanel.Hybrid/LunaticPanel.Hybrid.Web/LunaticPanel.Hybrid.Web.csproj",
                "-c",
                "Debug",
                "--runtime",
                "linux-x64",
                "-o",
                "${workspaceFolder}/.bin/publish",
                "/p:DebugType=portable",
                "/p:CopyOutputSymbolsToPublishDirectory=true"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "LPCLI with Plugins (Full Build)",
            "command": "${workspaceFolder}/tools/LunaticPanel.DebugTool/bin/Debug/net10.0/win-x64/LunaticPanel.DebugTool.exe",
            "type": "shell",
            "dependsOrder": "sequence", // Ensures they run in order, not at the same time
            "dependsOn": [
                "Publish DebugTool",
            ],
            "options": {
                "cwd": "${workspaceFolder}/plugins"
            },
            "args": [
                "--deploy",
                "--debug",
                "--clean",
                "--auto-kill",
                "--no-open",
                "--close-cli",
                "--skip-wsl",
                "--no-interaction"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "LPCLI with Plugins (Skip Service Build)",
            "command": "${workspaceFolder}/tools/LunaticPanel.DebugTool/bin/Debug/net10.0/win-x64/LunaticPanel.DebugTool.exe",
            "type": "shell",
            "dependsOrder": "sequence", // Ensures they run in order, not at the same time
            "dependsOn": [
                "Publish DebugTool",
            ],
            "options": {
                "cwd": "${workspaceFolder}/plugins"
            },
            "args": [
                "--deploy",
                "--debug",
                "--clean",
                "--auto-kill",
                "--close-cli",
                "--no-open",
                "--skip-wsl",
                "--skip-services",
                "--no-interaction"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Deploying Dev Envrionement (Partial Rebuild)", // <-- This is your empty parent task
            "dependsOrder": "sequence", // Ensures child tasks run one after another
            "dependsOn": [
                "LPCLI with Plugins (Skip Service Build)",
                "Install VSCODE Debugger",
                "Open Panel Logging",
                "Open LunaPackage Server Logging",
            ],
            "problemMatcher": []
        },
        {
            "label": "Deploying Dev Envrionement (Full Rebuild)", // <-- This is your empty parent task
            "dependsOrder": "sequence", // Ensures child tasks run one after another
            "dependsOn": [
                "LPCLI with Plugins (Full Build)",
                "Install VSCODE Debugger",
                "Open Panel Logging",
                "Open LunaPackage Server Logging",
            ],
            "problemMatcher": []
        }
    ]
}
// $GITHUB_WORKSPACE/src/LunaticPanel.Hybrid/LunaticPanel.Hybrid.Web/LunaticPanel.Hybrid.Web.csproj \
// -c Release \
// -r linux-x64 \
// --self-contained false \
// -o /tmp/artifacts/web
