{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "publish_debugger",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/tools/LunaticPanel.DebugTool/LunaticPanel.DebugTool.csproj",
                "-c",
                "Debug",
                "--self-contained",
                "true",
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish_plugins_noservices",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/tools/LunaticPanel.DebugTool/LunaticPanel.DebugTool.csproj",
                "-c",
                "Debug",
                "--self-contained",
                "true",
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
